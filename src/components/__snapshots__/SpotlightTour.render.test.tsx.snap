exports[`SpotlightTour > GC mode, the tour round five: a tour without onStep renders exactly as before, stop by stop > Back to the first stop 1`] = `"<div><div data-tour="tour-a">anchor</div></div><div style="position: fixed; inset: 0; z-index: 1000;" data-page-scroll="allow" data-testid="spotlight-tour-overlay"><div style="position: fixed; top: 0px; left: 0px; width: 1012px; height: 712px; border-radius: 12px; box-shadow: 0 0 0 200vmax rgba(0,0,0,0.55); border: 2px solid rgb(59, 130, 246); pointer-events: none; transition: top 0.15s, left 0.15s, width 0.15s, height 0.15s;"></div><div role="dialog" aria-modal="true" aria-label="First stop" tabindex="-1" style="position: fixed; top: 724px; left: 306px; width: 400px; background: var(--surface); color: var(--text-strong); border: 1px solid var(--border); border-radius: 10px; box-shadow: 0 14px 40px rgba(0,0,0,0.4); padding: 0.8rem 1rem; outline: none; transition: top 0.15s, left 0.15s;"><div style="display: flex; justify-content: space-between; align-items: baseline; gap: 0.6rem;"><strong style="font-size: 0.9rem;">First stop</strong><span style="font-size: 0.72rem; color: var(--text-muted); white-space: nowrap;">1 of 2</span></div><div style="font-size: 0.82rem; color: var(--text-700); margin: 0.35rem 0px 0.7rem;">A.</div><div style="display: flex; justify-content: space-between; align-items: center; gap: 0.5rem;"><button type="button" style="font-size: 0.8rem; padding: 0.35rem 0.75rem 0.35rem 0px; border-radius: 6px; background: none; color: var(--text-muted); cursor: pointer;">Skip tour</button><div style="display: flex; gap: 0.4rem; align-items: center;"><button type="button" style="font-size: 0.8rem; padding: 0.35rem 0.75rem; border-radius: 6px; background: rgb(59, 130, 246); color: rgb(255, 255, 255); cursor: pointer; font-weight: 600;">Next →</button></div></div></div></div>"`;

