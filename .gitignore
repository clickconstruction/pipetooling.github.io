# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# TypeScript incremental build info (tsc -b writes it under .cache/typecheck/) and the eslint cache
# (.cache/eslint/). CI restores both from main's latest push; never committed.
*.tsbuildinfo
.cache/

# Vite transient config timestamp artifacts
vite.config.ts.timestamp-*.mjs

# Vite dependency pre-bundle cache (regenerated on demand; normally node_modules/.vite)
.vite/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.env

# Local Supabase inspect snapshots (see docs/runbooks/SUPABASE_INCIDENT_RUNBOOK.md)
docs/runbooks/supabase-inspect-snapshot/

# Claude Code local config (machine-specific; .mcp.json is shared and tracked).
# .claude/ itself is NOT blanket-ignored: .claude/skills/ is versioned (project
# skills like /db-freeze must reach every session) — list local-only entries.
.claude/settings.local.json
.claude/launch.json
.claude/scheduled_tasks.lock
.claude/worktrees/
.claude/sessions/
.claude/settings.json

# Playwright E2E artifacts
e2e/.auth/
playwright-report/
test-results/

# The walk kit's reports (npm run walk), one JSON per run; never committed
tmp/walk/
